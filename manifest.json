{
  "manifest_version": 2,
  "name": "fafix",
  "version": "1.0",

  "description": "fa ui improvements",

  "icons": {
    "48": "icons/border-48.png"
  },

  "content_scripts": [
    {
      "matches": ["*://*.furaffinity.net/browse/*"],
      "js": ["brows.js"],
      "css": ["stylez.css"]
    },
    {
      "matches": ["*://*.furaffinity.net/msg/submissions/*"],
      "js": ["subby.js"],
      "css": ["stylez.css"]
    }
  ],
  "permissions": [
"cookies",
"storage",
"<all_urls>"
    ],

"browser_specific_settings": {
  "gecko": {
    "id": "fafix@fuckyou"
  }
}
}
